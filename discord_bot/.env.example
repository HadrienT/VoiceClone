# Jeton du bot (https://discord.com/developers/applications)
DISCORD_TOKEN=
# Adresse du serveur VoiceClone
VOICECLONE_URL=http://127.0.0.1:7860
# Valeurs par défaut pour /say
VOICECLONE_MODEL=xtts-v2
VOICECLONE_VOICE=
VOICECLONE_LANGUAGE=fr
# Mot de passe si VoiceClone est lancé avec VOICECLONE_PASSWORD
VOICECLONE_PASSWORD=
# /lire : lecture à voix haute d'un salon textuel (activez aussi « Message Content Intent » sur le portail)
DISCORD_READ_MESSAGES=0
# Nombre maximal de phrases en attente par serveur
DISCORD_MAX_QUEUE=20
